{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "ESNext.TypedArrays", "DOM", "DOM.Iterable"],
    "noEmitOnError": true,
    "erasableSyntaxOnly": true,
    "outDir": "public/js",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": false
  },
  "include": ["src"]
}
